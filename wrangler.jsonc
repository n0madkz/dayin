{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"dayin",
 "workers_dev":true,
 "preview_urls":false,
 "main":"cloudflare/worker.mjs",
 "compatibility_date":"2026-10-11",
 "compatibility_flags":["nodejs_compat"],
 "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":true,"html_handling":"none"},
 "alias":{"node:sqlite":"./cloudflare/sqlite-placeholder.cjs"},
 "durable_objects":{"bindings":[{"name":"PLATFORM","class_name":"DayinPlatform"},{"name":"RESTAURANTS","class_name":"RestaurantOrders"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["DayinPlatform"]},{"tag":"v2","new_sqlite_classes":["RestaurantOrders"]}],
 "observability":{"enabled":true}
}
